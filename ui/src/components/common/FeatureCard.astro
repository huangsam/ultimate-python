---
interface Props {
  title: string;
  description: string;
  href?: string;
}

const { title, description, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class={`info-card ${href ? 'clickable' : ''}`}>
  <div class="info-icon">
    <slot name="icon" />
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</Tag>

<style>
  .info-card {
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    transition:
      transform var(--transition-speed),
      border-color var(--transition-speed);
  }

  .info-card:hover {
    transform: translateY(-2px);
    border-color: var(--forest-green);
  }

  .info-card.clickable {
    text-decoration: none;
    color: inherit;
    display: block;
    cursor: pointer;
  }

  .info-card.clickable:hover h3 {
    color: var(--forest-green-light);
  }

  .info-icon {
    color: var(--forest-green);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
  }

  h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  p {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
</style>
