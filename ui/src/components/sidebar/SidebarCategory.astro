---
interface LessonItem {
  id: string;
  name: string;
  path: string;
}

interface Props {
  id?: string;
  name: string;
  lessons: LessonItem[];
  activePath?: string;
  activeLang?: string;
}

const { id, name, lessons, activePath, activeLang = 'en' } = Astro.props;
const categoryId =
  id || (lessons.length > 0 ? lessons[0].path.split('/')[0] : '');
const isCategoryActive = activePath === categoryId;
const hasActiveChild = lessons.some((l) => l.path === activePath);
const isOpen = hasActiveChild || isCategoryActive || activePath === undefined;
---

<details
  class="category-group"
  open={isOpen}
  data-category-name={name.toLowerCase()}
  data-category-id={categoryId.toLowerCase()}
>
  <summary class="category-title">
    <a
      href={`/ultimate-python/${activeLang}/${categoryId}/`}
      class={`category-link ${isCategoryActive ? 'active' : ''}`}
      data-category-link
    >
      <span class="category-name">{name}</span>
      <span class="category-count">({lessons.length})</span>
    </a>
    <button
      type="button"
      class="category-toggle"
      aria-label={`Toggle ${name}`}
      data-category-toggle
    >
      <span class="toggle-icon">▾</span>
    </button>
  </summary>
  <ul class="lesson-list">
    {lessons.map((lesson) => {
      const isActive = lesson.path === activePath;
      return (
        <li
          class="lesson-item"
          data-lesson-id={lesson.id}
          data-lesson-name={lesson.name.toLowerCase()}
        >
          <a
            href={`/ultimate-python/${activeLang}/${lesson.path}/`}
            class={`lesson-link ${isActive ? 'active' : ''}`}
          >
            <span class="lesson-name">{lesson.name}</span>
          </a>
        </li>
      );
    })}
  </ul>
</details>

<style>
  .category-group {
    margin-bottom: 1.25rem;
  }

  .category-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    cursor: default;
    user-select: none;
    padding: 0.15rem 0;
  }

  .category-title::-webkit-details-marker {
    display: none;
  }

  .category-link {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.5rem;
    border-radius: 4px;
    font-family: var(--font-sans);
    color: var(--forest-green);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: all var(--transition-speed);
  }

  .category-link:hover {
    background-color: var(--bg-tertiary);
  }

  .category-link.active {
    background-color: var(--forest-green-soft);
    color: var(--forest-green);
    font-weight: 700;
  }

  .category-name {
    flex: 1;
    min-width: 0;
    line-height: 1.35;
  }

  .category-count {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-left: 0.5rem;
    margin-right: 0.25rem;
    flex-shrink: 0;
    font-weight: 500;
  }

  .category-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--forest-green);
    padding: 0;
    margin-left: 0.25rem;
    transition: background-color var(--transition-speed);
  }

  .category-toggle:hover {
    background-color: var(--bg-tertiary);
  }

  .toggle-icon {
    font-size: 0.8rem;
    display: inline-block;
    transition: transform var(--transition-speed);
    line-height: 1;
  }

  .category-group[open] .toggle-icon {
    transform: rotate(-180deg);
  }

  .lesson-list {
    list-style: none;
    padding-left: 0.5rem;
    margin-top: 0.25rem;
    border-left: 1px solid var(--border-color);
  }

  .lesson-item {
    margin-bottom: 0.25rem;
  }

  .lesson-link {
    display: flex;
    align-items: center;
    padding: 0.4rem 0.5rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    border-radius: 4px;
    transition: all var(--transition-speed);
    gap: 0.5rem;
  }

  .lesson-link:hover {
    background-color: var(--bg-tertiary);
    color: var(--text-primary);
  }

  .lesson-link.active {
    background-color: var(--forest-green-soft);
    color: var(--forest-green);
    font-weight: 500;
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { mountOnPageLoad } from '../../utils/lifecycle';

  mountOnPageLoad((signal) => {
    // Intercept category navigation link clicks to perform smooth View Transitions
    // without triggering native summary toggle
    document.querySelectorAll('[data-category-link]').forEach((link) => {
      link.addEventListener(
        'click',
        (e) => {
          const mouseEvent = e as MouseEvent;
          if (
            mouseEvent.metaKey ||
            mouseEvent.ctrlKey ||
            mouseEvent.shiftKey ||
            mouseEvent.altKey ||
            mouseEvent.button !== 0
          ) {
            return;
          }
          e.preventDefault();
          e.stopPropagation();
          const href = (link as HTMLAnchorElement).getAttribute('href');
          if (href) {
            navigate(href);
          }
        },
        { signal }
      );
    });

    // Make the explicit toggle button toggle details
    document.querySelectorAll('[data-category-toggle]').forEach((btn) => {
      btn.addEventListener(
        'click',
        (e) => {
          e.stopPropagation();
          e.preventDefault();
          const details = btn.closest('details');
          if (details) {
            details.open = !details.open;
          }
        },
        { signal }
      );
    });
  });
</script>
