---
import lessons from '../../data/lessons.json';
import categoryOrder from '../../data/categories.json';
import {
  languages,
  useTranslations,
  type ui,
  defaultLang,
} from '../../i18n/ui';
import { ChevronLeft, ChevronRight, Clock } from '@lucide/astro';
import LanguageSelector from './LanguageSelector.astro';
import SidebarSearch from './SidebarSearch.astro';
import SidebarCategory from './SidebarCategory.astro';

type SupportedLang = keyof typeof languages;
type TranslationKey = keyof (typeof ui)[typeof defaultLang];

interface Props {
  activePath?: string;
  activeLang?: SupportedLang;
}

const { activePath, activeLang = 'en' } = Astro.props;
const t = useTranslations(activeLang);
const isTimelineActive = activePath === 'python-versions';

// Group lessons by category
const categoriesMap = lessons.reduce(
  (acc, lesson) => {
    const cat = lesson.category;
    if (!acc[cat]) {
      acc[cat] = {
        name: t(`category.${cat}` as TranslationKey) || lesson.category_name,
        lessons: [],
      };
    }
    acc[cat].lessons.push(lesson);
    return acc;
  },
  {} as Record<string, { name: string; lessons: typeof lessons }>
);
---

<aside class="sidebar">
  <button
    id="sidebar-toggle"
    class="sidebar-toggle-btn"
    aria-label="Toggle Sidebar"
  >
    <span class="arrow-left">
      <ChevronLeft size={16} />
    </span>
    <span class="arrow-right">
      <ChevronRight size={16} />
    </span>
  </button>

  <div class="sidebar-header">
    <div class="header-top">
      <a href={`/ultimate-python/${activeLang}/`} class="sidebar-logo">
        <svg
          class="sidebar-logo-svg"
          version="1.1"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 40 40"
        >
          <defs>
            <mask id="logo-mask-sidebar">
              <rect x="0" y="0" width="40" height="40" fill="white"></rect>
              <circle cx="14.5" cy="5" r="1.85" fill="black"></circle>
              <circle cx="25.5" cy="35" r="1.85" fill="black"></circle>
              <line
                x1="10"
                y1="9.5"
                x2="20"
                y2="9.5"
                stroke="black"
                stroke-width="1.5"
              ></line>
              <line
                x1="20"
                y1="30.5"
                x2="30"
                y2="30.5"
                stroke="black"
                stroke-width="1.5"
              ></line>
              <path
                d="m 9.5,30 c 0,-10 2.5,-10 10,-10 8.5,0 11,0 11,-10"
                stroke="black"
                stroke-width="1.5"
                fill="none"
              ></path>
            </mask>
          </defs>
          <g mask="url(#logo-mask-sidebar)">
            <rect
              x="10"
              y="0"
              width="20"
              height="40"
              rx="10"
              ry="5"
              fill="currentColor"
            ></rect>
            <rect
              x="0"
              y="10"
              width="40"
              height="20"
              rx="5"
              ry="10"
              fill="currentColor"
            ></rect>
          </g>
        </svg>
        <span class="logo-text">Ultimate Python</span>
      </a>

      <LanguageSelector activeLang={activeLang} />
    </div>

    <SidebarSearch placeholder={t('search.placeholder')} />
  </div>

  <nav class="sidebar-nav">
    <div class="sidebar-pinned">
      <a
        href={`/ultimate-python/${activeLang}/python-versions/`}
        class={`pinned-link ${isTimelineActive ? 'active' : ''}`}
      >
        <span class="pinned-icon">
          <Clock size={16} />
        </span>
        <span class="pinned-label">{t('nav.timeline')}</span>
      </a>
    </div>

    {categoryOrder.map((catKey) => {
      const cat = categoriesMap[catKey];
      if (!cat) return null;

      return (
        <SidebarCategory
          id={catKey}
          name={cat.name}
          lessons={cat.lessons}
          activePath={activePath}
          activeLang={activeLang}
        />
      );
    })}
    <div id="search-empty-state" class="search-empty-state hidden-search">
      <p>{t('search.empty')}</p>
    </div>
  </nav>
</aside>
<div class="sidebar-backdrop" id="sidebar-backdrop"></div>

<style>
  .sidebar {
    width: var(--sidebar-width);
    background-color: var(--bg-secondary);
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    flex-shrink: 0;
    position: relative;
  }

  :global(html.sidebar-transitioning) .sidebar {
    transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sidebar-toggle-btn {
    position: absolute;
    right: -15px;
    top: 15px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--forest-green);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
    z-index: 100;
    transition:
      background-color var(--transition-speed),
      transform var(--transition-speed);
    outline: none;
    font-size: 0.9rem;
    font-weight: bold;
  }

  :global(html.sidebar-transitioning) .sidebar-toggle-btn {
    transition:
      right 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      background-color var(--transition-speed),
      transform var(--transition-speed);
  }

  .arrow-left,
  .arrow-right {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .arrow-right {
    display: none;
  }

  :global(html.sidebar-collapsed) .arrow-left {
    display: none;
  }

  :global(html.sidebar-collapsed) .arrow-right {
    display: flex;
  }

  .sidebar-toggle-btn:hover {
    background-color: var(--bg-tertiary);
    transform: scale(1.05);
  }

  :global(html.sidebar-collapsed) .sidebar {
    margin-left: calc(-1 * var(--sidebar-width));
  }

  :global(html.sidebar-collapsed) .sidebar-toggle-btn {
    right: -45px;
  }

  .sidebar-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .header-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    width: 100%;
  }

  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--forest-green);
    width: 100%;
  }

  .sidebar-logo-svg {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.5rem;
  }

  .sidebar-pinned {
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .pinned-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    border-radius: 6px;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    transition:
      background-color var(--transition-speed),
      border-color var(--transition-speed),
      color var(--transition-speed),
      transform var(--transition-speed);
  }

  .pinned-link:hover {
    background-color: var(--bg-tertiary);
    border-color: var(--forest-green);
    color: var(--forest-green);
    transform: translateX(2px);
  }

  .pinned-link.active {
    background-color: var(--forest-green-soft);
    border-color: var(--forest-green);
    color: var(--forest-green);
  }

  .pinned-icon {
    display: flex;
    align-items: center;
    color: var(--forest-green);
    flex-shrink: 0;
  }

  .pinned-label {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search-empty-state {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .sidebar-backdrop {
    display: none;
  }

  @media (width <= 900px) {
    .sidebar {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      z-index: 1000;
      box-shadow: 5px 0 15px rgba(0, 0, 0, 0.1);
    }

    :global(html.sidebar-mobile-open) .sidebar-backdrop {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.4);
      z-index: 999;
    }
  }
</style>

<script>
  import { mountOnPageLoad } from '../../utils/lifecycle';

  mountOnPageLoad((signal) => {
    const toggleBtn = document.getElementById('sidebar-toggle');
    const backdrop = document.getElementById('sidebar-backdrop');

    if (toggleBtn) {
      // Load initial state
      const stored = localStorage.getItem('sidebar-collapsed');
      const isMobile = window.innerWidth < 900;
      const isCollapsed = isMobile || stored === 'true';
      document.documentElement.classList.remove('sidebar-mobile-open');
      if (isCollapsed) {
        document.documentElement.classList.add('sidebar-collapsed');
      } else {
        document.documentElement.classList.remove('sidebar-collapsed');
      }

      const closeSidebar = () => {
        document.documentElement.classList.add('sidebar-transitioning');
        document.documentElement.classList.add('sidebar-collapsed');
        document.documentElement.classList.remove('sidebar-mobile-open');
        localStorage.setItem('sidebar-collapsed', 'true');
      };

      // Close mobile drawer when navigating via sidebar links
      const navLinks = document.querySelectorAll(
        '.sidebar-nav a, .sidebar-logo'
      );
      navLinks.forEach((link) => {
        link.addEventListener(
          'click',
          () => {
            if (window.innerWidth < 900) {
              closeSidebar();
            }
          },
          { signal }
        );
      });

      toggleBtn.addEventListener(
        'click',
        () => {
          document.documentElement.classList.add('sidebar-transitioning');
          const collapsed =
            document.documentElement.classList.toggle('sidebar-collapsed');
          localStorage.setItem('sidebar-collapsed', String(collapsed));
          // Show/hide mobile backdrop only on explicit user toggle
          if (window.innerWidth < 900) {
            if (collapsed) {
              document.documentElement.classList.remove('sidebar-mobile-open');
            } else {
              document.documentElement.classList.add('sidebar-mobile-open');
            }
          }
        },
        { signal }
      );

      if (backdrop) {
        backdrop.addEventListener('click', closeSidebar, { signal });
      }

      // Clean up transitioning class when transition finishes
      const sidebar = document.querySelector('.sidebar');
      if (sidebar) {
        const clearTransition = () => {
          document.documentElement.classList.remove('sidebar-transitioning');
        };
        sidebar.addEventListener('transitionend', clearTransition, { signal });
        sidebar.addEventListener('transitioncancel', clearTransition, {
          signal,
        });
      }

      // Auto-collapse/expand on window resize (transitions are disabled by default here)
      let lastWidth = window.innerWidth;
      window.addEventListener(
        'resize',
        () => {
          const currentWidth = window.innerWidth;
          const wasDesktop = lastWidth >= 900;
          const isMobile = currentWidth < 900;

          if (wasDesktop && isMobile) {
            document.documentElement.classList.add('sidebar-collapsed');
            document.documentElement.classList.remove('sidebar-mobile-open');
          } else if (!wasDesktop && !isMobile) {
            // Always expand the sidebar on desktop width and save state
            document.documentElement.classList.remove('sidebar-collapsed');
            document.documentElement.classList.remove('sidebar-mobile-open');
            localStorage.setItem('sidebar-collapsed', 'false');
          }
          lastWidth = currentWidth;
        },
        { signal }
      );
    }

    // Handle sidebar logo click to prevent reloading if already on landing page
    const logoLink = document.querySelector(
      '.sidebar-logo'
    ) as HTMLAnchorElement | null;
    if (logoLink) {
      logoLink.addEventListener(
        'click',
        (e) => {
          const currentPath = window.location.pathname;
          const targetPath = logoLink.getAttribute('href');

          const normalize = (p: string | null) =>
            p ? p.replace(/\/+$/, '') : '';
          if (normalize(currentPath) === normalize(targetPath)) {
            e.preventDefault();
          }
        },
        { signal }
      );
    }
  });
</script>
