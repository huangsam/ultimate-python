---
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import { useTranslations } from '../../i18n/ui';

interface LessonSummary {
  name: string;
  path: string;
}

interface Props {
  prevLesson?: LessonSummary | null;
  nextLesson?: LessonSummary | null;
  activeLang?: string;
}

const { prevLesson, nextLesson, activeLang = 'en' } = Astro.props;
const t = useTranslations(activeLang as any);
---

<nav class="lesson-nav" aria-label="Lesson">
  {prevLesson ? (
    <a
      href={`/ultimate-python/${activeLang}/${prevLesson.path}/`}
      class="lesson-nav-btn prev"
      aria-keyshortcuts="["
      data-lesson-nav="prev"
    >
      <span class="nav-direction">
        <ChevronLeft size={14} aria-hidden="true" />
        <span>{t('nav.prev')}</span>
        <kbd class="nav-kbd" aria-hidden="true">
          [
        </kbd>
      </span>
      <span class="nav-title">{prevLesson.name}</span>
    </a>
  ) : (
    <div class="nav-spacer" />
  )}

  {nextLesson ? (
    <a
      href={`/ultimate-python/${activeLang}/${nextLesson.path}/`}
      class="lesson-nav-btn next"
      aria-keyshortcuts="]"
      data-lesson-nav="next"
    >
      <span class="nav-direction">
        <kbd class="nav-kbd" aria-hidden="true">
          ]
        </kbd>
        <span>{t('nav.next')}</span>
        <ChevronRight size={14} aria-hidden="true" />
      </span>
      <span class="nav-title">{nextLesson.name}</span>
    </a>
  ) : (
    <div class="nav-spacer" />
  )}
</nav>

<style>
  .lesson-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 1.5rem 2.25rem 1.5rem;
    border-top: 1px solid #2d2d30;
    margin-top: 1rem;
  }

  .lesson-nav-btn {
    display: flex;
    flex-direction: column;
    padding: 0.55rem 1rem;
    border-radius: 6px;
    background-color: #252526;
    border: 1px solid #333333;
    color: #cccccc;
    transition: all var(--transition-speed);
    min-width: 140px;
    max-width: 45%;
    text-decoration: none;
  }

  .lesson-nav-btn:hover,
  .lesson-nav-btn:focus-visible {
    background-color: #2d2d30;
    border-color: var(--forest-green-light);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .lesson-nav-btn:focus-visible {
    outline: 2px solid #52b788;
    outline-offset: 2px;
  }

  .lesson-nav-btn.next {
    margin-left: auto;
    align-items: flex-end;
    text-align: right;
  }

  .nav-direction {
    font-size: 0.68rem;
    color: #858585;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-sans);
    margin-bottom: 0.5rem;
    line-height: 1.2;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lesson-nav-btn:hover .nav-direction,
  .lesson-nav-btn:focus-visible .nav-direction {
    color: #52b788;
  }

  .nav-kbd {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #9d9d9d;
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    padding: 0.05rem 0.3rem;
    line-height: 1.1;
    text-transform: none;
    letter-spacing: 0;
    transition:
      border-color var(--transition-speed),
      color var(--transition-speed);
  }

  .lesson-nav-btn:hover .nav-kbd,
  .lesson-nav-btn:focus-visible .nav-kbd {
    border-color: rgba(82, 183, 136, 0.5);
    color: #52b788;
  }

  .nav-title {
    font-size: 0.88rem;
    font-weight: 500;
    line-height: 1.3;
    color: #ffffff;
    font-family: var(--font-sans);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .nav-spacer {
    flex: 1;
  }

  @media (width <= 640px) {
    .lesson-nav {
      padding: 1.25rem 0.875rem 1.75rem 0.875rem;
      gap: 0.5rem;
    }

    .lesson-nav-btn {
      padding: 0.5rem 0.75rem;
      min-width: 120px;
    }

    .nav-kbd {
      display: none;
    }

    .nav-title {
      font-size: 0.82rem;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { mountOnPageLoad } from '../../utils/lifecycle';

  mountOnPageLoad((signal) => {
    const prevLink = document.querySelector<HTMLAnchorElement>(
      '[data-lesson-nav="prev"]'
    );
    const nextLink = document.querySelector<HTMLAnchorElement>(
      '[data-lesson-nav="next"]'
    );
    if (!prevLink && !nextLink) return;

    document.addEventListener(
      'keydown',
      (e) => {
        if (e.defaultPrevented || e.repeat) return;
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
        if (e.key !== '[' && e.key !== ']') return;

        const active = document.activeElement as HTMLElement | null;
        if (
          active &&
          (active.tagName === 'INPUT' ||
            active.tagName === 'TEXTAREA' ||
            active.tagName === 'SELECT' ||
            active.isContentEditable)
        ) {
          return;
        }

        const targetLink = e.key === '[' ? prevLink : nextLink;
        const href = targetLink?.getAttribute('href');
        if (href) {
          e.preventDefault();
          navigate(href);
        }
      },
      { signal }
    );
  });
</script>
