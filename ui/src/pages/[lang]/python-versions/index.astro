---
import AppShell from '../../../layouts/AppShell.astro';
import TimelineCard from '../../../components/timeline/TimelineCard.astro';
import { languages, useTranslations } from '../../../i18n/ui';
import lessons from '../../../data/lessons.json';
import { Clock, ListFilter } from '@lucide/astro';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const activeLang = lang as keyof typeof languages;
const t = useTranslations(activeLang);

// Extract and sort timeline lessons reverse chronologically
function parseVersionMinor(versionStr: string): number {
  const match = versionStr.match(/3\.(\d+)/);
  return match ? parseInt(match[1], 10) : 0;
}

const annotatedLessons = lessons
  .filter((lesson) => lesson.annotation)
  .sort((a, b) => {
    const minorA = parseVersionMinor(a.annotation!.version);
    const minorB = parseVersionMinor(b.annotation!.version);
    if (minorB !== minorA) {
      return minorB - minorA;
    }
    return a.name.localeCompare(b.name);
  });

// Extract unique version numbers for filter pills
const versionTags = Array.from(
  new Set(
    annotatedLessons.map((l) =>
      l.annotation!.version.replace(/^Python\s*/, '').trim()
    )
  )
).sort(
  (a, b) =>
    parseInt(b.split('.')[1] || '0', 10) - parseInt(a.split('.')[1] || '0', 10)
);
---

<AppShell
  title={t('timeline.title')}
  activePath="python-versions"
  activeLang={activeLang}
>
  <main class="timeline-container animate-fade-in">
    <div class="timeline-content">
      <header class="timeline-header">
        <div class="header-badge-row">
          <span class="timeline-pill">
            <Clock size={14} />
            <span>{t('timeline.badge')}</span>
          </span>
          <span class="feature-count-badge">
            {annotatedLessons.length} {t('timeline.features')}
          </span>
        </div>

        <h1 class="timeline-title">{t('timeline.title')}</h1>
        <p class="timeline-subtitle">{t('timeline.subtitle')}</p>

        <!-- Scalable Version Selector -->
        <div class="version-filter-controls">
          <label for="version-select" class="filter-label">
            <ListFilter size={15} />
            <span>{t('timeline.filterBy')}:</span>
          </label>
          <div class="select-wrapper">
            <select
              id="version-select"
              class="version-select"
              aria-label={t('timeline.filterBy')}
            >
              <option value="all">{t('timeline.filterAll')}</option>
              {versionTags.map((v) => (
                <option value={v}>Python {v}</option>
              ))}
            </select>
          </div>
        </div>
      </header>

      <section class="cards-section" id="timeline-cards">
        <div class="cards-grid">
          {annotatedLessons.map((lesson) => (
            <TimelineCard
              version={lesson.annotation!.version}
              pep={lesson.annotation!.pep || ''}
              pepUrl={lesson.annotation!.pep_url || ''}
              feature={lesson.annotation!.feature}
              summary={lesson.annotation!.summary || lesson.docstring}
              lessonName={lesson.name}
              lessonPath={lesson.path}
              activeLang={activeLang}
              openLessonText={t('timeline.openLesson')}
              pepSpecText={t('timeline.pepSpec')}
            />
          ))}
        </div>
      </section>
    </div>
  </main>
</AppShell>

<script>
  function setupTimelineFilters() {
    const versionSelect = document.getElementById(
      'version-select'
    ) as HTMLSelectElement | null;
    const cards = document.querySelectorAll<HTMLElement>('.timeline-card');

    if (!versionSelect || !cards.length) return;

    function applyFilter(selectedVersion: string, updateHash = true) {
      if (versionSelect) {
        versionSelect.value = selectedVersion;
      }

      cards.forEach((card) => {
        const cardVersion = card.dataset.version;
        if (selectedVersion === 'all' || cardVersion === selectedVersion) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      if (updateHash) {
        if (selectedVersion === 'all') {
          if (window.location.hash) {
            history.replaceState(
              null,
              '',
              window.location.pathname + window.location.search
            );
          }
        } else {
          history.replaceState(null, '', `#${selectedVersion}`);
        }
      }
    }

    versionSelect.addEventListener('change', () => {
      applyFilter(versionSelect.value);
    });

    // Check URL hash on initial load
    function checkHash() {
      const hash = window.location.hash.replace(/^#/, '').trim();
      const availableVersions = Array.from(versionSelect!.options).map(
        (o) => o.value
      );
      if (hash && availableVersions.includes(hash)) {
        applyFilter(hash, false);
      } else {
        applyFilter('all', false);
      }
    }

    checkHash();
    window.addEventListener('hashchange', checkHash);
  }

  // Setup on initial load and view transition swap
  setupTimelineFilters();
  document.addEventListener('astro:page-load', setupTimelineFilters);
</script>

<style>
  .timeline-container {
    flex: 1;
    overflow-y: auto;
    padding: 3.5rem 2rem 4rem 2rem;
    padding-left: 3.5rem;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    background-color: var(--bg-primary);
  }

  .timeline-content {
    max-width: 960px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .timeline-header {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .header-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .timeline-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background-color: var(--forest-green-soft);
    color: var(--forest-green);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .feature-count-badge {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    font-weight: 500;
  }

  .timeline-title {
    font-size: clamp(2.2rem, 4.5vw, 2.75rem);
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .timeline-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 820px;
    margin: 0;
  }

  .version-filter-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .select-wrapper {
    position: relative;
    min-width: 200px;
    max-width: 260px;
  }

  .select-wrapper::after {
    content: '▾';
    font-size: 0.8rem;
    color: var(--text-secondary);
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-55%);
    pointer-events: none;
  }

  .version-select {
    width: 100%;
    padding: 0.5rem 2.25rem 0.5rem 0.85rem;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-primary);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    outline: none;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    transition:
      border-color var(--transition-speed),
      background-color var(--transition-speed);
  }

  .version-select:hover {
    border-color: var(--forest-green);
    background-color: var(--bg-primary);
  }

  .version-select:focus {
    border-color: var(--forest-green);
    box-shadow: 0 0 0 2px var(--forest-green-soft);
  }

  .cards-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 1.5rem;
  }

  @media (width <= 900px) {
    .timeline-container {
      padding: 2.5rem 1.25rem 3.5rem 1.25rem;
      padding-left: 3.5rem;
    }

    .timeline-content {
      gap: 2rem;
    }

    .timeline-title {
      font-size: 1.95rem;
    }

    .timeline-subtitle {
      font-size: 1rem;
    }

    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
