---
import { Code } from 'astro/components';
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import CodeHeader from '../../components/CodeHeader.astro';
import LessonNav from '../../components/LessonNav.astro';
import { languages } from '../../i18n/ui';
import lessons from '../../data/lessons.json';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of Object.keys(languages)) {
    for (let i = 0; i < lessons.length; i++) {
      const lesson = lessons[i];
      const prevLesson = i > 0 ? lessons[i - 1] : null;
      const nextLesson = i < lessons.length - 1 ? lessons[i + 1] : null;
      paths.push({
        params: { lang, path: lesson.path },
        props: { lesson, prevLesson, nextLesson },
      });
    }
  }
  return paths;
}

const { lang } = Astro.params;
const { lesson, prevLesson, nextLesson } = Astro.props;
const activeLang = lang as keyof typeof languages;
---

<Layout title={lesson.name}>
  <div class="app-container" id="app-container">
    <Sidebar activePath={lesson.path} activeLang={activeLang} />

    <!-- Code Editor Pane (Middle) -->
    <main class="code-pane">
      <CodeHeader
        filename={lesson.filename}
        annotation={lesson.annotation}
        code={lesson.code}
      />

      <div class="code-scroller">
        <Code code={lesson.code} lang="py" theme="github-dark" />

        <LessonNav
          prevLesson={prevLesson}
          nextLesson={nextLesson}
          activeLang={activeLang}
        />
      </div>
    </main>
  </div>
</Layout>

<style>
  /* Three-pane layout split */
  .code-pane {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #1e1e1e; /* Dark editor background to contrast with sand UI */
    border-right: 1px solid var(--border-color);
    position: relative;
    overflow: hidden;
    container-type: inline-size;
    container-name: code-pane;
  }

  .code-scroller {
    flex: 1;
    overflow: auto;
    background-color: #1e1e1e;
    scrollbar-width: thin;
    scrollbar-color: #3e3e3e #1e1e1e;
  }

  .code-scroller::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  .code-scroller::-webkit-scrollbar-track {
    background: #1e1e1e;
  }

  .code-scroller::-webkit-scrollbar-thumb {
    background: #3e3e3e;
    border: 2px solid #1e1e1e;
    border-radius: 6px;
  }

  .code-scroller::-webkit-scrollbar-thumb:hover {
    background: #4f4f4f;
  }

  /* Override default Astro code element backgrounds */
  .code-scroller :global(pre) {
    background-color: transparent !important;
    padding: 1.5rem !important;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .code-scroller :global(code),
  .code-scroller :global(code span) {
    font-family: inherit;
  }

  /* Boost syntax comment contrast against dark editor background for WCAG AA compliance */
  .code-scroller :global(span[style*='color:#6A737D']),
  .code-scroller :global(span[style*='color:#6a737d']) {
    color: #8b949e !important;
  }

  @media (width <= 900px) {
    /* Stack container vertically */
    #app-container {
      flex-direction: column !important;
    }

    .code-pane {
      width: 100% !important;
      flex: 1;
      border-right: none;
    }
  }

  @media (width <= 640px) {
    .code-scroller :global(pre) {
      padding: 1rem 0.875rem !important;
      font-size: 0.8125rem;
      line-height: 1.45;
    }
  }
</style>
