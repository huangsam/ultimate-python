---
import { Code } from 'astro/components';
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { languages, useTranslations } from '../../i18n/ui';
import lessons from '../../data/lessons.json';
import { Terminal, Play, Copy, Check, ChevronLeft, ChevronRight } from '@lucide/astro';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of Object.keys(languages)) {
    for (let i = 0; i < lessons.length; i++) {
      const lesson = lessons[i];
      const prevLesson = i > 0 ? lessons[i - 1] : null;
      const nextLesson = i < lessons.length - 1 ? lessons[i + 1] : null;
      paths.push({
        params: { lang, path: lesson.path },
        props: { lesson, prevLesson, nextLesson },
      });
    }
  }
  return paths;
}

const { lang } = Astro.params;
const { lesson, prevLesson, nextLesson } = Astro.props;
const activeLang = lang as keyof typeof languages;
const t = useTranslations(activeLang);
---

<Layout title={lesson.name}>
  <div class="app-container" id="app-container">
    <Sidebar activePath={lesson.path} activeLang={activeLang} />

    <!-- Code Editor Pane (Middle) -->
    <main class="code-pane">
      <div class="pane-header">
        <div class="filename-badge">
          <span class="file-icon">
            <Terminal size={16} />
          </span>
          <span class="filename-text">{lesson.filename}</span>
          {lesson.annotation && (
            <span class="annotation-badge" title={lesson.annotation.feature}>
              {lesson.annotation.version}
            </span>
          )}
        </div>
        <div class="action-buttons">
          <button
            id="copy-code-btn"
            class="action-btn btn-copy"
            data-code={lesson.code}
            aria-label="Copy Code"
          >
            <span class="btn-icon btn-copy-icon">
              <Copy size={14} />
            </span>
            <span class="btn-icon btn-check-icon" style="display: none;">
              <Check size={14} />
            </span>
            <span class="btn-text">Copy Code</span>
          </button>
          <a
            href={`https://replit.com/github/huangsam/ultimate-python`}
            target="_blank"
            rel="noopener noreferrer"
            class="action-btn btn-replit"
          >
            <span class="btn-icon">
              <Play size={14} fill="currentColor" />
            </span>
            <span class="btn-text-full">Run on Replit</span>
            <span class="btn-text-short">Run</span>
          </a>
        </div>
      </div>

      <div class="code-scroller">
        <Code code={lesson.code} lang="py" theme="github-dark" />

        <!-- Lesson Pagination Footer -->
        <nav class="lesson-nav" aria-label="Lesson navigation">
          {prevLesson ? (
            <a
              href={`/ultimate-python/${activeLang}/${prevLesson.path}/`}
              class="lesson-nav-btn prev"
            >
              <span class="nav-direction">
                <ChevronLeft size={14} />
                <span>{t('nav.prev')}</span>
              </span>
              <span class="nav-title">{prevLesson.name}</span>
            </a>
          ) : (
            <div class="nav-spacer" />
          )}

          {nextLesson ? (
            <a
              href={`/ultimate-python/${activeLang}/${nextLesson.path}/`}
              class="lesson-nav-btn next"
            >
              <span class="nav-direction">
                <span>{t('nav.next')}</span>
                <ChevronRight size={14} />
              </span>
              <span class="nav-title">{nextLesson.name}</span>
            </a>
          ) : (
            <div class="nav-spacer" />
          )}
        </nav>
      </div>
    </main>
  </div>
</Layout>

<style>
  /* Three-pane layout split */
  .code-pane {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #1e1e1e; /* Dark editor background to contrast with sand UI */
    border-right: 1px solid var(--border-color);
    position: relative;
    overflow: hidden;
    container-type: inline-size;
    container-name: code-pane;
  }

  .pane-header {
    height: 60px;
    background-color: #252526;
    border-bottom: 1px solid #333333;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
    /* Constant padding-left to clear the floating sidebar toggle button in all */
    /* states (open/collapsed) without triggering layout reflow and text shifting. */
    padding-left: 3.5rem;
    flex-shrink: 0;
  }

  .filename-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .file-icon {
    color: #858585;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .filename-text {
    font-family: var(--font-mono);
    color: #cccccc;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .annotation-badge {
    background-color: rgba(45, 106, 79, 0.25);
    color: #52b788;
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    margin-left: 0.5rem;
    border: 1px solid rgba(82, 183, 136, 0.3);
    font-family: var(--font-sans);
    white-space: nowrap;
    cursor: help;
  }

  @media (width <= 480px) {
    .annotation-badge {
      display: none;
    }
  }

  .action-buttons {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .action-btn {
    padding: 0.5rem 0.9rem;
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    border: none;
    transition: all var(--transition-speed);
    display: inline-flex;
    align-items: center;
  }

  .btn-replit {
    background-color: #3c3c3c;
    color: #ffffff;
    text-decoration: none;
  }

  .btn-replit:hover {
    background-color: #4e4e4e;
  }

  .btn-text-short {
    display: none;
  }

  .btn-icon {
    margin-right: 0.4rem;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  @media (width <= 969px) {
    .btn-text,
    .btn-text-full,
    .btn-text-short {
      display: none;
    }
    .btn-icon {
      margin-right: 0 !important;
    }
    .action-btn {
      padding: 0.5rem 0.6rem;
    }
  }

  .code-scroller {
    flex: 1;
    overflow: auto;
    background-color: #1e1e1e;
    scrollbar-width: thin;
    scrollbar-color: #3e3e3e #1e1e1e;
  }

  .code-scroller::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  .code-scroller::-webkit-scrollbar-track {
    background: #1e1e1e;
  }

  .code-scroller::-webkit-scrollbar-thumb {
    background: #3e3e3e;
    border: 2px solid #1e1e1e;
    border-radius: 6px;
  }

  .code-scroller::-webkit-scrollbar-thumb:hover {
    background: #4f4f4f;
  }

  /* Override default Astro code element backgrounds */
  .code-scroller :global(pre) {
    background-color: transparent !important;
    padding: 1.5rem !important;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .code-scroller :global(code),
  .code-scroller :global(code span) {
    font-family: inherit;
  }

  /* Boost syntax comment contrast against dark editor background for WCAG AA compliance */
  .code-scroller :global(span[style*='color:#6A737D']),
  .code-scroller :global(span[style*='color:#6a737d']) {
    color: #8b949e !important;
  }

  .btn-copy {
    background-color: #2d2d30;
    color: #cccccc;
    border: 1px solid #3e3e42;
  }

  .btn-copy:hover {
    background-color: #3e3e42;
    color: #ffffff;
  }

  .btn-copy.copied {
    background-color: var(--forest-green-light) !important;
    border-color: var(--forest-green-light) !important;
    color: #ffffff !important;
  }

  @media (width <= 900px) {
    /* Stack container vertically */
    #app-container {
      flex-direction: column !important;
    }

    .code-pane {
      width: 100% !important;
      flex: 1;
      border-right: none;
    }
  }

  /* Lesson-to-lesson pagination */
  .lesson-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 2.5rem 1.5rem 3.5rem 1.5rem;
    border-top: 1px solid #2d2d30;
    margin-top: 1.5rem;
  }

  .lesson-nav-btn {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1.25rem;
    border-radius: 6px;
    background-color: #252526;
    border: 1px solid #333333;
    color: #cccccc;
    transition: all var(--transition-speed);
    min-width: 160px;
    max-width: 45%;
    text-decoration: none;
  }

  .lesson-nav-btn:hover {
    background-color: #2d2d30;
    border-color: var(--forest-green-light);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .lesson-nav-btn.next {
    margin-left: auto;
    align-items: flex-end;
    text-align: right;
  }

  .nav-direction {
    font-size: 0.72rem;
    color: #858585;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-sans);
    margin-bottom: 0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lesson-nav-btn:hover .nav-direction {
    color: #52b788;
  }

  .nav-title {
    font-size: 0.95rem;
    font-weight: 500;
    color: #ffffff;
    font-family: var(--font-sans);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .nav-spacer {
    flex: 1;
  }

  @media (width <= 640px) {
    .code-scroller :global(pre) {
      padding: 1rem 0.875rem !important;
      font-size: 0.8125rem;
      line-height: 1.45;
    }

    .lesson-nav {
      padding: 1.5rem 0.875rem 2.5rem 0.875rem;
      gap: 0.5rem;
    }

    .lesson-nav-btn {
      padding: 0.75rem 0.875rem;
      min-width: 130px;
    }

    .nav-title {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  if (!(window as any).copyListenerBound) {
    (window as any).copyListenerBound = true;

    document.addEventListener('click', async (e) => {
      const copyBtn = (e.target as HTMLElement).closest(
        '#copy-code-btn'
      ) as HTMLButtonElement;
      if (!copyBtn) return;

      const copyIcon = copyBtn.querySelector('.btn-copy-icon') as HTMLElement;
      const checkIcon = copyBtn.querySelector('.btn-check-icon') as HTMLElement;
      const btnText = copyBtn.querySelector('.btn-text') as HTMLElement;
      const code = copyBtn.getAttribute('data-code') || '';

      try {
        await navigator.clipboard.writeText(code);

        // Show success state
        if (copyIcon) copyIcon.style.display = 'none';
        if (checkIcon) checkIcon.style.display = 'inline-flex';
        if (btnText) btnText.textContent = 'Copied!';
        copyBtn.classList.add('copied');

        // Reset state after 2 seconds
        setTimeout(() => {
          if (copyIcon) copyIcon.style.display = 'inline-flex';
          if (checkIcon) checkIcon.style.display = 'none';
          if (btnText) btnText.textContent = 'Copy Code';
          copyBtn.classList.remove('copied');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy code: ', err);
      }
    });
  }
</script>
