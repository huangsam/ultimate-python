---
import Button from '../../components/Button.astro';
import AppShell from '../../layouts/AppShell.astro';
import { languages, useTranslations } from '../../i18n/ui';
import lessons from '../../data/lessons.json';
import { BookOpen, Settings, Zap, ArrowRight } from '@lucide/astro';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const activeLang = lang as keyof typeof languages;
const t = useTranslations(activeLang);
const totalLessons = lessons.length;
---

<AppShell title={t('site.title')} titleSuffix="Home" activeLang={activeLang}>
  <main class="welcome-container animate-fade-in">
    <div class="welcome-content">
      <header class="welcome-header">
        <h1>{t('welcome.title')}</h1>
        <p class="subtitle">{t('welcome.subtitle')}</p>
      </header>

      <div class="cta-group">
        <Button
          href={`/ultimate-python/${lang}/fundamentals/variable/`}
          variant="primary"
        >
          {t('nav.start')}
          <ArrowRight size={16} class="btn-arrow" />
        </Button>
        <Button
          href="https://github.com/huangsam/ultimate-python"
          target="_blank"
          rel="noopener"
          variant="secondary"
        >
          {t('nav.github')}
        </Button>
      </div>

      <section class="info-grid">
        <div class="info-card">
          <div class="info-icon">
            <BookOpen size={24} />
          </div>
          <h3>
            {totalLessons} {t('card.lessons.title')}
          </h3>
          <p>{t('card.lessons.desc')}</p>
        </div>

        <div class="info-card">
          <div class="info-icon">
            <Settings size={24} />
          </div>
          <h3>{t('card.stdlib.title')}</h3>
          <p>{t('card.stdlib.desc')}</p>
        </div>

        <div class="info-card">
          <div class="info-icon">
            <Zap size={24} />
          </div>
          <h3>{t('card.run.title')}</h3>
          <p>{t('card.run.desc')}</p>
        </div>
      </section>

      <section class="philosophy-section">
        <h3>{t('zen.title')}</h3>
        <blockquote>
          <p>"Beautiful is better than ugly."</p>
          <p>"Explicit is better than implicit."</p>
          <p>"Simple is better than complex."</p>
          <cite>— Tim Peters</cite>
        </blockquote>
      </section>
    </div>
  </main>
</AppShell>

<style>
  .welcome-container {
    flex: 1;
    overflow-y: auto;
    padding: 4rem 2rem;
    /* Constant padding-left to clear the floating sidebar toggle button in all */
    /* states (open/collapsed) without triggering layout reflow and text shifting. */
    padding-left: 3.5rem;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    background-color: var(--bg-primary);
  }

  .welcome-content {
    max-width: 800px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .welcome-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.35rem);
    line-height: 1.25;
    margin-top: 0.5rem;
    letter-spacing: -0.01em;
  }

  .subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .cta-group {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .info-card {
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    transition: transform var(--transition-speed);
  }

  .info-card:hover {
    transform: translateY(-2px);
    border-color: var(--forest-green);
  }

  .info-icon {
    color: var(--forest-green);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
  }

  .info-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .info-card p {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .philosophy-section {
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }

  .philosophy-section h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  blockquote {
    border-left: 3px solid var(--forest-green);
    padding-left: 1.25rem;
    font-family: var(--font-serif);
    color: var(--text-secondary);
    font-size: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  blockquote cite {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-style: normal;
  }

  @media (width <= 900px) {
    .welcome-container {
      padding: 3rem 1.25rem;
      /* Constant padding-left to clear the floating toggle button on mobile. */
      padding-left: 3.5rem;
    }

    .welcome-content {
      gap: 2.5rem;
    }

    h1 {
      font-size: 1.75rem;
    }

    .subtitle {
      font-size: 0.95rem;
    }

    .cta-group {
      flex-wrap: wrap;
      gap: 0.75rem;
      width: 100%;
    }
  }
</style>
