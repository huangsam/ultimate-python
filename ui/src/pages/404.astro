---
import Button from '../components/common/Button.astro';
import AppShell from '../layouts/AppShell.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { ArrowRight } from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

Astro.response.status = 404;
---

<AppShell title={t('notFound.title')} activeLang={lang}>
  <main class="not-found-container animate-fade-in">
    <div class="not-found-content">
      <p class="not-found-code">404</p>
      <h1>{t('notFound.title')}</h1>
      <p class="not-found-message">{t('notFound.message')}</p>

      <div class="cta-group">
        <Button href={`/ultimate-python/${lang}/`} variant="secondary">
          {t('nav.home')}
        </Button>
        <Button
          href={`/ultimate-python/${lang}/fundamentals/variable/`}
          variant="primary"
        >
          {t('nav.start')}
          <ArrowRight size={16} class="btn-arrow" />
        </Button>
      </div>
    </div>
  </main>
</AppShell>

<style>
  .not-found-container {
    flex: 1;
    overflow-y: auto;
    padding: 4rem 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--bg-primary);
  }

  .not-found-content {
    max-width: 560px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .not-found-code {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--forest-green-light);
  }

  h1 {
    font-size: 2.25rem;
    line-height: 1.2;
  }

  .not-found-message {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .cta-group {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }
</style>
